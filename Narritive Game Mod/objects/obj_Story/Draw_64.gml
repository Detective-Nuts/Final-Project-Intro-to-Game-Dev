draw_set_font(Font2);
draw_set_colour(c_yellow)
draw_set_halign(fa_center);
draw_text_ext(x,y,"Long ago in a distant land there lived a man capable of not just jumping but jumping so well that he was the only one left capable of saving the entire universe. That man is Jumping Jones. During the intercontinental space war of super death, a black hole ruptured the fabric of space and time. The only way to fix it is by having our brave hero get to the end of this level. go jumping jones. you're our last hope!",100, 700);


draw_set_font(Font1);
draw_set_colour(c_white)
draw_text(160,room_height - 50,"Press Space to Start");
