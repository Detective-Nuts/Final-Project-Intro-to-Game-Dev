draw_set_font(Font2);
draw_set_colour(c_yellow)
draw_set_halign(fa_center);
draw_text_ext(x,y,"Long ago in a distant land there lived a man capable of not just jumping but jumping so well that he was the only one left capable of saving the entire universe. That man was Jumping Jones. During the intercontinental space war of super death, a black hole ruptured the fabric of space and time. The only way to fix it is by having our brave hero get to the end of this level. However Jumping jones has lost his luster and become a more calm relaxed man. Can he face these challenges and make it to the end? go jumping jones. you're our only hope!",100, 700);


draw_set_font(Font4);
draw_set_colour(c_white)
draw_text_ext(170,room_height - 80,"Press Space to Start",30, 190);
